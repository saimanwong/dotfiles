log() {
  printf '[%s] %s\n' "$(date '+%Y-%m-%dT%H:%M:%S%z')" "$1"
}

announce() (
  # Keep cleanup local to speech; starting or stopping an idle watcher changes no audio.
  trap 'osascript -e "set volume output muted true"' EXIT
  trap 'exit 130' INT
  trap 'exit 143' TERM
  osascript -e 'set volume output volume 50 output muted false' && say "$1"
)

previous=
reminders_left=0
next_reminder=0
log 'Watching the charger. Three unplug reminders, five seconds apart. Ctrl+C stops.'
pmset -g pslog | while :; do
  if (( reminders_left > 0 )); then
    wait_seconds=$((next_reminder - SECONDS))
    (( wait_seconds > 0 )) || wait_seconds=1
    if IFS= read -r -t "$wait_seconds" line; then
      :
    else
      # ponytail: Bash 3.2 conflates timeout and EOF; EOF at a deadline can allow one last reminder.
      # Use a native event API if that distinction matters.
      (( SECONDS >= next_reminder )) || break
      line=
    fi
  else
    IFS= read -r line || break
  fi

  case "$line" in
    "Now drawing from 'AC Power'") source=AC ;;
    "Now drawing from 'Battery Power'") source=battery ;;
    *) source=$previous ;;
  esac

  if [[ $source != "$previous" ]]; then
    log "Power source: $source"
    case "$previous:$source" in
      AC:battery)
        reminders_left=3
        next_reminder=$SECONDS
        ;;
      battery:AC)
        reminders_left=0
        message=${plugged_messages[RANDOM % ${#plugged_messages[@]}]}
        log "Announcing reconnect thanks: $message"
        announce "$message"
        ;;
    esac
    previous=$source
  fi
  if (( reminders_left > 0 && SECONDS >= next_reminder )); then
    message=${unplugged_messages[RANDOM % ${#unplugged_messages[@]}]}
    log "Announcing unplug reminder $((4 - reminders_left))/3: $message"
    announce "$message"
    reminders_left=$((reminders_left - 1))
    next_reminder=$((SECONDS + 5))
  fi
done
